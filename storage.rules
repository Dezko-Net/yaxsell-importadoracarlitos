rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'dezkonet@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Imágenes de catálogo públicas. Las escrituras requieren la cuenta admin.
    match /carlitos/productos/{filePath=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /carlitos/banners/{filePath=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /carlitos/categorias/{filePath=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /carlitos/thumbnails/{filePath=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /comprobantes/carlitos/{filePath=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /carlitos/chat/{filePath=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /media/{filePath=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Comprobantes, chat y cualquier otro objeto son privados para el público.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
